<div class="lifecycle-bar"><div class="lifecycle-pill learning">LEARNING: 4</div><div class="lifecycle-pill reportable">REPORTABLE: 10</div></div><div style="background:#ecfdf5;border-left:4px solid #10b981;padding:14px 18px;margin:12px 0 20px 0;border-radius:0 8px 8px 0;">
